---
import Base from '../../layouts/Base.astro';
import Presenter from '../../components/Presenter.astro';
import { loadDeck, loadAllDecks, deckDir } from '../../engine/load';
import { renderFrameHtml } from '../../engine/markdown';
import type { DeckIR } from '../../engine/types';

/** Padres primero: el DOM pinta después = hijos encima del pane opaco. */
function preorderFrameIds(ir: DeckIR): string[] {
  const out: string[] = [];
  const seen = new Set<string>();
  const walk = (id: string) => {
    if (seen.has(id)) return;
    seen.add(id);
    const f = ir.frames[id];
    if (!f) return;
    out.push(id);
    for (const c of f.children) walk(c);
  };
  walk(ir.root);
  for (const id of Object.keys(ir.frames)) walk(id);
  return out;
}

export function getStaticPaths() {
  return loadAllDecks().map((d) => ({ params: { slug: d.slug } }));
}

const { slug } = Astro.params;
if (!slug) throw new Error('slug requerido');
const ir = loadDeck(deckDir(slug));
const boot = {
  slug: ir.slug,
  root: ir.root,
  path: ir.path,
  camera: ir.camera,
  video: ir.video,
  frames: preorderFrameIds(ir).map((id) => {
    const f = ir.frames[id];
    return {
      id: f.id,
      layout: f.layout,
      children: f.children,
      geometry: f.geometry ?? null,
      html: renderFrameHtml(f.markdown, ir.slug),
    };
  }),
};
---
<Base title={ir.title} lang={ir.lang} presenting>
  <Presenter boot={boot} />
</Base>
