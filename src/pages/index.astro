---
import Base from '../layouts/Base.astro';
import DeckList from '../components/DeckList.astro';
import { loadAllDecks } from '../engine/load';

const decks = loadAllDecks();
---
<Base>
  <p class="kicker">Índice</p>
  <h1>prezi-slides</h1>
  <p class="lede">
    Visor espacial de decks: un árbol de frames en un lienzo 2D. La
    fuente de verdad es texto en git.
  </p>
  <DeckList decks={decks} />
</Base>
