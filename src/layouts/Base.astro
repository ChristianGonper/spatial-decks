---
interface Props {
  title?: string;
}
const { title } = Astro.props;
const docTitle = title ? `${title} — prezi-slides` : 'prezi-slides';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{docTitle}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
